node_modules/
.DS_Store
*.log

# Local content mirror, pending the Syncjar integration.
_local-mirror/

# Project config belongs with the content, not with the tool.
# Copy errata.config.example.yaml to your content repository. A local one here
# is only for development against a checkout in _local-mirror/.
# errata.yaml is the name used before 0.2.0, still read and still ignored here.
errata.config.yaml
errata.yaml

# The exception is the config of the synthetic content repositories under
# tests/fixtures/. Those describe fixture content rather than real content,
# and CI needs them, because the real content is not available there.
#
# Matched by wildcard rather than named one by one. The dirty fixture was
# added with a rule naming only the clean one, so `git add -A` skipped its
# config without saying anything and CI failed on a file that looked
# committed.
!tests/fixtures/*/errata.config.yaml
